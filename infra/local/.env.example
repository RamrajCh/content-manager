# Documentation template only. Run scripts\initialize-local.ps1 to generate .env.
# Never use these local-development settings for staging or production.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5080
Platform__LocalServices=true
Platform__Mongo__Database=contentmanager_development
Platform__Mongo__ConnectionString=
Platform__Storage__Endpoint=http://127.0.0.1:19000
Platform__Storage__Bucket=contentmanager-private
Platform__Storage__AccessKey=
Platform__Storage__SecretKey=
Platform__Mail__Host=127.0.0.1
Platform__Mail__Port=11025
Platform__Security__KeyVersion=v1
Platform__Security__EncryptionKey=
Platform__Security__LookupKey=
LOCAL_MONGO_USER=contentmanager_local
LOCAL_MONGO_PASSWORD=
